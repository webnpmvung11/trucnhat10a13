rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đọc dữ liệu lịch trực nhật công khai (học sinh, phụ huynh theo dõi mà không cần đăng nhập)
    // Bắt buộc xác thực người dùng (request.auth != null) đối với tất cả các thao tác Thêm / Sửa / Xóa dữ liệu
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
